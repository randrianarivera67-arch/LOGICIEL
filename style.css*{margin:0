<h3 id="formTitle"><svg class="ni"><use href="#i-plus"></use></svg> <span id="formTitleText">Ajouter un produit</span></h3>
<label>Nom *<input id="f-name" placeholder="Ex : Adobe Photoshop 2026"></label>
<div class="row2">
<label>Type<select id="f-type"><option value="Logiciel">Logiciel</option><option value="Application">Application</option></select></label>
<label>Catégorie<input id="f-cat" list="catList" placeholder="Ex : Design"><datalist id="catList"></datalist></label>
</div>
<div class="row2">
<label>Plateforme<select id="f-os"><option value="Windows">Windows</option><option value="MacOS">MacOS</option><option value="Android">Android</option><option value="Linux">Linux</option><option value="Autre">Autre</option></select></label>
<label>Version<input id="f-version" placeholder="Ex : 27.0"></label>
</div>
<div class="row2">
<label>Taille<input id="f-size" placeholder="Ex : 4.8 Go"></label>
<label>Téléchargements<input id="f-dl" type="number" min="0" placeholder="Ex : 174205"></label>
</div>
<div class="row2">
<label>Prix *<input id="f-price" placeholder="Ex : 120 000 Ar"></label>
<label>Note /5<input id="f-rate" type="number" min="0" max="5" step="0.5" placeholder="4.5"></label>
</div>
<label>Lien de téléchargement *<input id="f-link" type="url" placeholder="https://…"></label>
<label>Image (URL ou fichier)
<div class="row2">
<input id="f-image" placeholder="https://…/icone.png" oninput="updatePreview()">
<label class="btn ghost file-btn" style="cursor:pointer"><svg class="ni ni-sm"><use href="#i-image"></use></svg> Choisir<input id="f-file" type="file" accept="image/*" hidden onchange="onFileChange(this)"></label>
</div>
<div id="f-preview" class="preview" hidden><img alt="Aperçu"></div>
</label>
<label>Informations<textarea id="f-info" rows="4" placeholder="Description courte…"></textarea></label>
<label>Mode d'installation (1 étape par ligne)<textarea id="f-install" rows="5" placeholder="Étape 1…&#10;Étape 2…"></textarea></label>
<div class="form-actions">
<button class="btn primary" type="button" onclick="doSubmit()" id="btnSubmit"><svg class="ni"><use href="#i-plus"></use></svg> <span id="btnSubmitText">Publier</span></button>
<button class="btn ghost" type="button" id="btnCancel" hidden onclick="resetForm()"><svg class="ni ni-sm"><use href="#i-close"></use></svg> Annuler</button>
</div>
</form>
